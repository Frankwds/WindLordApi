{
    "$schema": "../archetype.schema.json",
    "name": "hello-world",
    "displayName": "Hello World",
    "description": "A simple starter archetype. Use it to learn how dev-cli archetypes work, then replace it with your own.",
    "version": "1.0.0",
    "parameters": {
        "name": {
            "type": "string",
            "description": "A name to greet",
            "required": true
        }
    },
    "files": [
        {
            "template": "hello-world.txt.scriban",
            "output": "hello-{{name}}.txt"
        }
    ]
}