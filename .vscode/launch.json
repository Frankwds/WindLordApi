{
  "version": "0.2.0",
  "configurations": [
    {
      // Use IntelliSense to find out which attributes exist for C# debugging
      // Use hover for the description of the existing attributes
      // For further information visit https://github.com/dotnet/vscode-csharp/blob/main/debugger-launchjson.md
      "name": ".NET Core Launch (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      // If you have changed target frameworks, make sure to update the program path.
      "program": "${workspaceFolder}/src/WindLordApi.Worker/bin/Debug/net9.0/WindLordApi.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/WindLordApi.Worker",
      // For more information about the 'console' field, see https://aka.ms/VSCode-CS-LaunchJson-Console
      "console": "internalConsole",
      "logging": {
        "moduleLoad": false
      },
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IS_LOCAL": "false"
      }
    },
    {
      "name": ".NET Core Launch (Production)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/WindLordApi.Worker/bin/Debug/net9.0/WindLordApi.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/WindLordApi.Worker",
      "console": "internalConsole",
      "logging": {
        "moduleLoad": false
      },
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Production",
        "IS_LOCAL": "false"
      }
    },
    {
      "name": ".NET Core Launch (Local)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/WindLordApi.Worker/bin/Debug/net9.0/WindLordApi.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/WindLordApi.Worker",
      "console": "internalConsole",
      "logging": {
        "moduleLoad": false
      },
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Local",
        "IS_LOCAL": "true"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}